# Argo-Singbox 配置导入示例。
# 首次安装：bash argo-singbox.sh -i -f /path/to/argo-singbox.env
# 已安装：ags -f /path/to/argo-singbox.env

UUID='首次安装时自动生成'
ARGO_DOMAIN='必须输入自己的隧道域名'
SERVER='polestar.com'
SERVER_PORT='443'
ARGO_TOKEN=''
ORIGIN_PORT='3010'
WARP_ENABLED='0'
WARP_PROXY_PORT='40000'
WARP_DOMAINS=''
WARP_GEOSITES=''
STATS_API_PORT='18085'
BRUTAL_UP_MBPS='1000'
BRUTAL_DOWN_MBPS='1000'
MULTIPLEX_ENABLED='1'
TCP_BRUTAL_ENABLED='1'
OUTBOUND_IP_FAMILY='auto'

# Language: use ags -l; default Chinese, persisted separately in config/language.
# nodes.conf fifth field: http://user:pass@host:port or socks5://user:pass@host:port
